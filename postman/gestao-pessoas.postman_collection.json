  "item": [
    {
      "name": "00 - Preparar nova execução e verificar saúde",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const token = pm.variables.replaceIn(\"{{$guid}}\");",
              "  [\"departmentId\", \"positionId\", \"employeeId\"].forEach(key => pm.collectionVariables.unset(key));",
              "  pm.collectionVariables.set(\"runToken\", token);",
              "  pm.collectionVariables.set(\"departmentName\", \"RH Postman \" + token.slice(0, 8));",
              "  pm.collectionVariables.set(\"employeeName\", \"Ana Postman \" + token.slice(0, 8));",
              "  pm.collectionVariables.set(\"employeeEmail\", \"postman-\" + token + \"@example.com\");",
              "  pm.collectionVariables.set(\"employeeEmailUpper\", pm.collectionVariables.get(\"employeeEmail\").toUpperCase());",
              "  pm.collectionVariables.set(\"missingDepartmentId\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "  pm.collectionVariables.set(\"missingPositionId\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "  pm.collectionVariables.set(\"missingEmployeeId\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "  pm.test(\"Aplicação UP\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/actuator/health",
        "description": "Inicia uma rodada com dados novos e limpa os IDs da rodada anterior. Execute primeiro. baseUrl é a única variável do environment."
      },
      "response": []
    },
    {
      "name": "01 - Cadastrar departamento",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  if (!pm.collectionVariables.get(\"runToken\")) { throw new Error(\"Execute os cadastros anteriores: falta runToken.\"); }",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "  const data = pm.response.json();",
              "  pm.test(\"UUID gerado\", function () { pm.expect(data.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i); });",
              "  pm.test(\"Location do recurso\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/departments/\" + data.id); });",
              "  pm.test(\"Nome do departamento\", function () { pm.expect(data.name).to.eql(pm.collectionVariables.get(\"departmentName\")); });",
              "  pm.collectionVariables.set(\"departmentId\", data.id);",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
