        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/employees?name={{employeeName}}&status=INACTIVE&page=0&size=20",
        "description": "Confere que o cadastro foi preservado e mudou de estado."
      },
