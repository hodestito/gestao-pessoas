              "  pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "  const data = pm.response.json();",
              "  pm.test(\"Formato da página\", function () {",
              "    pm.expect(data).to.have.all.keys(\"content\", \"page\", \"size\", \"totalElements\", \"totalPages\");",
              "    pm.expect(data.page).to.eql(0);",
              "    pm.expect(data.size).to.eql(20);",
              "    pm.expect(data.totalElements).to.be.at.least(1);",
              "  });",
              "  pm.test(\"Cadastro preservado em INACTIVE\", function () { pm.expect(data.content.some(e => e.id === pm.collectionVariables.get(\"employeeId\") && e.status === \"INACTIVE\")).to.eql(true); });",
              "})();"
            ]
          }
        }
      ],
